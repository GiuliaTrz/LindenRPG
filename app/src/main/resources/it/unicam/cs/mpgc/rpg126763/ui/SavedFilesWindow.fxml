<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="250.0" prefWidth="400.0"
            style="-fx-background-image: url('/it/unicam/cs/mpgc/rpg126763/images/BackgroundLinden.png');
                   -fx-background-size: cover;
                   -fx-background-position: center center;
                   -fx-background-repeat: no-repeat;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.unicam.cs.mpgc.rpg126763.ui.DeleteSaveController">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0" />
    </padding>
    <left>
        <ListView fx:id="saveListView" prefWidth="240.0" prefHeight="200.0"
                  BorderPane.alignment="CENTER"
                  style="-fx-background-color: rgba(245, 240, 230, 0.8);
                         -fx-background-radius: 10;
                         -fx-border-color: #6b4f3a;
                         -fx-border-radius: 10;
                         -fx-border-width: 2;
                         -fx-font-family: 'Verdana';
                         -fx-font-size: 12px;
                         -fx-text-fill: #4a3b2a;" />
    </left>
    <right>
        <StackPane prefWidth="120.0" prefHeight="200.0" BorderPane.alignment="CENTER">
            <Button fx:id="deleteButton" text="Elimina"
                    onAction="#handleDeleteAction"
                    style="-fx-background-color: rgba(173, 122, 65, 0.9);
                           -fx-text-fill: #f5f0e6;
                           -fx-font-size: 12px;
                           -fx-font-weight: bold;
                           -fx-font-family: 'Verdana';
                           -fx-padding: 8 16;
                           -fx-background-radius: 10;
                           -fx-border-color: #3e5c3a;
                           -fx-border-width: 2;
                           -fx-border-radius: 10;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 4, 0, 0, 2);" />
        </StackPane>
    </right>
</BorderPane>