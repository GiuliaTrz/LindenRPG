<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.Region?>

<StackPane prefHeight="600.0" prefWidth="800.0"
           xmlns="http://javafx.com/javafx/23.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unicam.cs.mpgc.rpg126763.ui.GameWindowController">

    <ImageView fx:id="backgroundImage"
               fitWidth="800" fitHeight="600"
               preserveRatio="false">
        <image>
            <Image url="@../images/forest_background.jpg" backgroundLoading="true"/>
        </image>
    </ImageView>

    <BorderPane fx:id="dialogueMode">

        <!-- Immagine speaker in alto -->
        <top>
            <StackPane alignment="TOP_CENTER" styleClass="speaker-image-container">
                <ImageView fx:id="speakerImage"
                           fitWidth="200" fitHeight="200"
                           preserveRatio="true"
                           visible="false"/>
            </StackPane>
        </top>

        <!-- Spazio vuoto centrale -->
        <center />

        <!-- Box dialogo in basso -->
        <bottom>
            <VBox spacing="15" styleClass="dialogue-box">
                <Text fx:id="speakerText" text="Speakers"/>
                <ScrollPane fitToWidth="true" styleClass="dialogue-scroll">
                    <TextArea fx:id="dialogueTextArea" editable="false" wrapText="true"/>
                </ScrollPane>
            </VBox>
        </bottom>
    </BorderPane>

    <!-- combattimento -->
    <BorderPane fx:id="battleMode" visible="false" managed="false">

        <!-- Barra di stato in alto -->
        <top>
            <HBox spacing="50" alignment="CENTER_LEFT" styleClass="battle-status-bar">
                <!-- Stato giocatore -->
                <VBox spacing="5">
                    <Label fx:id="playerNameLabel" text="Lind"/>
                    <ProgressBar fx:id="playerHpBar" progress="1.0" prefWidth="200"/>
                    <Label fx:id="playerHpLabel" text="HP: 100/100" styleClass="label-hp"/>
                    <ProgressBar fx:id="playerMpBar" progress="1.0" prefWidth="200"/>
                    <Label fx:id="playerMpLabel" text="MP: 50/50" styleClass="label-mp"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Stato nemico -->
                <VBox spacing="5" alignment="CENTER_RIGHT">
                    <Label fx:id="enemyNameLabel" text="Water Slime"/>
                    <ProgressBar fx:id="enemyHpBar" progress="1.0" prefWidth="200"/>
                    <Label fx:id="enemyHpLabel" text="HP: 50/50" styleClass="label-hp"/>
                </VBox>
            </HBox>
        </top>

        <!-- Sprite del nemico -->
        <center>
            <ImageView fx:id="enemySprite" fitWidth="200" fitHeight="200" preserveRatio="true"/>
        </center>

        <!-- Azioni di combattimento -->
        <bottom>
            <VBox spacing="10" alignment="BOTTOM_CENTER" styleClass="battle-actions-box">
                <Text text="Scegli una mossa:" styleClass="battle-text"/>
                <HBox fx:id="skillsContainer" spacing="20" alignment="CENTER"/>
            </VBox>
        </bottom>
    </BorderPane>

    <VBox fx:id="optionsPanel"
          alignment="CENTER"
          spacing="15"
          fillWidth="false"
          maxWidth="-Infinity"
          maxHeight="-Infinity"
          StackPane.alignment="CENTER">
        <Text text="SCELTA" styleClass="options-title"/>
    </VBox>

</StackPane>