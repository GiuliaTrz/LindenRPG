<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.Region?>
<StackPane prefHeight="600.0" prefWidth="800.0"
           xmlns="http://javafx.com/javafx/23.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unicam.cs.mpgc.rpg126763.ui.GameWindowController">

    <ImageView fx:id="backgroundImage"
               fitWidth="800" fitHeight="600"
               preserveRatio="false">
        <image>
            <Image url="@../images/forest_background.jpg"
                   backgroundLoading="true"/>
        </image>
    </ImageView>


    <BorderPane fx:id="dialogueMode"
                style="-fx-background-color: rgba(0,0,0,0.15); -fx-padding: 20px;">

        <center>
            <!-- Spazio vuoto per vedere lo sfondo -->
        </center>

        <!-- box dialoghi -->
        <bottom>
            <VBox spacing="15"
                  style="-fx-padding: 20px;
             -fx-background-color: rgba(0,0,0,0.55);
             -fx-background-radius: 15px;
             -fx-border-radius: 15px;
             -fx-border-color: #f1c40f;
             -fx-border-width: 3px;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 20, 0, 0, 0);">
                <children>
                    <!-- Nome speaker -->
                    <Text fx:id="speakerText"
                          text="Speakers"
                          style="-fx-fill: #f1c40f; -fx-font-size: 16px; -fx-font-weight: bold;"/>

                    <!-- area dialogo -->
                    <ScrollPane fitToWidth="true"
                                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                        <TextArea fx:id="dialogueTextArea"
                                  editable="false"
                                  wrapText="true"
                                  style=""/>
                    </ScrollPane>
                </children>
            </VBox>
        </bottom>
    </BorderPane>

    <!-- area combattimento (che prima viene nascosta) -->

    <BorderPane fx:id="battleMode"
                visible="false"
                managed="false"
                style="-fx-background-color: rgba(0,0,0,0.4); -fx-padding: 20px;">

        <!-- barra di stato del combattimento -->
        <top>
            <HBox spacing="50" alignment="CENTER_LEFT"
                  style="-fx-padding: 15px; -fx-background-color: rgba(0,0,0,0.6); -fx-background-radius: 10px;">
                <children>
                    <!-- status giocatore -->
                    <VBox spacing="5">
                        <Label fx:id="playerNameLabel"
                               text="Lind"
                               style="-fx-text-fill: #ecf0f1; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <ProgressBar fx:id="playerHpBar"
                                     progress="1.0"
                                     prefWidth="200"
                                     style="-fx-accent: #e74c3c; -fx-background-radius: 10px; -fx-padding: 3px;"/>
                        <Label fx:id="playerHpLabel"
                               text="HP: 100/100"
                               style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;"/>
                        <ProgressBar fx:id="playerMpBar"
                                     progress="1.0"
                                     prefWidth="200"
                                     style="-fx-accent: #3498db; -fx-background-radius: 10px; -fx-padding: 3px;"/>
                        <Label fx:id="playerMpLabel"
                               text="MP: 50/50"
                               style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <VBox spacing="5" alignment="CENTER_RIGHT">
                        <Label fx:id="enemyNameLabel"
                               text="Water Slime"
                               style="-fx-text-fill: #e74c3c; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <ProgressBar fx:id="enemyHpBar"
                                     progress="1.0"
                                     prefWidth="200"
                                     style="-fx-accent: #e74c3c; -fx-background-radius: 10px; -fx-padding: 3px;"/>
                        <Label fx:id="enemyHpLabel"
                               text="HP: 50/50"
                               style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;"/>
                    </VBox>
                </children>
            </HBox>
        </top>

        <center>
            <ImageView fx:id="enemySprite"
                       fitWidth="200" fitHeight="200"
                       preserveRatio="true">
                <image>
                    <Image url="@../images/water_slime.png"
                           backgroundLoading="true"/>
                </image>
            </ImageView>
        </center>

        <bottom>
            <VBox spacing="10" alignment="BOTTOM_CENTER"
                  style="-fx-padding: 20px; -fx-background-color: rgba(0,0,0,0.7); -fx-background-radius: 15px;">
                <children>
                    <Text text="Scegli una mossa:"
                          style="-fx-fill: #f1c40f; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <HBox fx:id="skillsContainer"
                          spacing="20"
                          alignment="CENTER">
                    </HBox>
                </children>
            </VBox>
        </bottom>
    </BorderPane>

    <VBox fx:id="optionsPanel"
          alignment="CENTER_RIGHT"
          spacing="15"
          style="-fx-padding: 40px 30px 40px 40px; -fx-background-color: rgba(0,0,0,0.6); -fx-background-radius: 20px 0 0 20px; -fx-border-color: #f1c40f; -fx-border-width: 2px; -fx-border-radius: 20px 0 0 20px;">
        <children>
            <Text text="SCELTA"
                  style="-fx-fill: #f1c40f; -fx-font-size: 20px; -fx-font-weight: bold; -fx-font-family: 'Arial Black';"/>
        </children>
        <StackPane.margin>
            <javafx.geometry.Insets/>
        </StackPane.margin>
    </VBox>

</StackPane>